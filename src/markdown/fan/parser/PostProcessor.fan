**
** PostProcessors are run as the last step of parsing and provide an opportunity
** to inspect/modify the parsed AST before rendering.
**
@Js
mixin PostProcessor
{
  ** Post-process this node and return the result (which may be a modified node).
  abstract Node process(Node node)
}

**
** A post-processor for handling link resolution
**
@Js
@NoDoc mixin LinkResolver : PostProcessor, Visitor
{
  override Node process(Node node)
  {
    node.walk(this)
    return node
  }

  override Void visitLink(Link link) { resolve(link) }
  override Void visitImage(Image img) { resolve(img) }

  ** Resolve the given [LinkNode]. This will be called prior to any rendering
  ** for the given node and provides an opportunity to modify the link destination,
  ** mark the link as code, and change the link display text.
  protected abstract Void resolve(LinkNode linkNode)
}

**
** A post-processor for generating anchor ids for headings
**
@Js
@NoDoc class HeadingProcessor : PostProcessor, Visitor
{
  new make()
  {
    this.ids = [Str:Int?][:]
  }

  private [Str:Int?] ids

  ** Unicode letters, marks, decimal digits, connector punctuation (e.g. `_`),
  ** and hyphens. The "u" flag enables `\p{..}` classes in JS; Java ignores it.
  private static const Regex allowed := Regex(Str<|[\p{L}\p{Nl}\p{M}\p{Nd}\p{Pc}-]+|>, "u")

  override Node process(Node node)
  {
    node.walk(this)
    return node
  }

  ** Generate an anchor id per heading from its text
  override Void visitHeading(Heading heading)
  {
    heading.anchor = toAnchor(text(heading))
  }

  ** Get all the text content of the heading with markup formatting removed
  static Str text(Heading heading)
  {
    words := Str[,]
    heading.eachDescendant |node|
    {
      if (node is Text || node is Code) words.add(node->literal)
    }
    return words.join
  }

  ** Generate an id using the same rules as the commonmark-java heading anchor
  ** extension, which match [GitHub](https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax#section-links)
  **
  ** 1. Leading and trailing whitespace are removed
  ** 2. Letters are converted to lower case
  ** 3. Spaces are replaced by hyphens (`-`)
  ** 4. Only Unicode letters, marks, digits, connector punctuation (e.g. `_`),
  **    and hyphens are kept. Everything else, including emoji, is removed
  ** 5. If nothing is left the anchor is `id`
  ** 6. If the auto-generated anchor for a heading is identical to an earlier anchor
  **    in the same document, a unique identifier is generated by appending a hyphen and
  **    an auto-incrementing integer.
  Str toAnchor(Str text)
  {
    // normalize to lower case with spaces replaced by hyphens and the
    // emoji/text presentation selectors removed
    text = text.trim.localeLower.replace(" ", "-").replace("\uFE0E", "").replace("\uFE0F", "")

    // build the anchor from only the allowed chars
    buf := StrBuf()
    m := allowed.matcher(text)
    while (m.find) buf.add(m.group)
    anchor := buf.isEmpty ? "id" : buf.toStr

    // check for collision
    id := ids.get(anchor)
    if (id == null)
    {
      // never seen this anchor before
      ids[anchor] = 0
    }
    else
    {
      // seen this anchor before, so append auto-incrementing integer
      id = id + 1
      ids[anchor] = id
      anchor = "${anchor}-${id}"
    }

    // done!
    return anchor
  }
}

